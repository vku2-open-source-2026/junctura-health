# Copy to .env (never committed). Every value is optional.

# Where the Junctura DX-OS checkout lives. Default: ../junctura-dxos
#JUNCTURA_DXOS_DIR=../junctura-dxos

# Shared password of the demo accounts. When unset, a random one is generated once
# and kept in .junctura/demo/accounts.env.
#DEMO_PASSWORD=

{
  "schema": {
    "type": "object",
    "required": [
      "kind",
      "requestId",
      "admissionId",
      "noteId",
      "items",
      "validDays",
      "reviewConfirmed",
      "overrideReason",
      "patientSubject",
      "patientName",
      "prescriptionCode",
      "issuedAt",
      "expiresAt",
      "dispensed",
      "createdBy"
    ],
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "hospital-prescription/v1"
        ]
      },
      "requestId": {
        "type": "string",
        "minLength": 1
      },
      "admissionId": {
        "type": "string",
        "minLength": 1
      },
      "noteId": {
        "type": "string",
        "minLength": 1
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "strength",
            "quantity",
            "instructions"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "strength": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      },
      "validDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30
      },
      "reviewConfirmed": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "overrideReason": {
        "type": "string",
        "maxLength": 500
      },
      "patientSubject": {
        "type": "string",
        "minLength": 1
      },
      "patientName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "birthYear": {},
      "sex": {
        "type": "string",
        "enum": [
          "male",
          "female",
          "unknown"
        ]
      },
      "prescriptionCode": {
        "type": "string",
        "minLength": 1
      },
      "issuedAt": {
        "type": "string",
        "format": "date-time"
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      },
      "dispensed": {
        "type": "boolean"
      },
      "createdBy": {
        "type": "object",
        "required": [
          "subject",
          "displayName"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "allergyReview": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "medicine": {
                  "type": "string"
                },
                "allergen": {
                  "type": "string"
                },
                "severity": {
                  "type": "string"
                }
              }
            }
          },
          "stale": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "indexed": [
    "requestId",
    "admissionId",
    "issuedAt",
    "patientSubject",
    "prescriptionCode"
  ],
  "uniqueKey": "requestId",
  "searchable": [],
  "sensitive": [
    "patientSubject",
    "patientName",
    "birthYear",
    "sex",
    "items",
    "overrideReason",
    "allergyReview",
    "prescriptionCode",
    "admissionId",
    "noteId",
    "createdBy"
  ]
}

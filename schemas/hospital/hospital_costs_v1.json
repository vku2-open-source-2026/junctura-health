{
  "schema": {
    "type": "object",
    "required": [
      "kind",
      "requestId",
      "admissionId",
      "noteId",
      "patientSubject",
      "patientName",
      "claimId",
      "items",
      "amountVnd",
      "insuranceStatus",
      "confirmed",
      "createdBy"
    ],
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "hospital-cost/v1"
        ]
      },
      "requestId": {
        "type": "string",
        "minLength": 1
      },
      "admissionId": {
        "type": "string",
        "minLength": 1
      },
      "noteId": {
        "type": "string",
        "minLength": 1
      },
      "patientSubject": {
        "type": "string",
        "minLength": 1
      },
      "patientName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "birthYear": {},
      "sex": {
        "type": "string",
        "enum": [
          "male",
          "female",
          "unknown"
        ]
      },
      "claimId": {
        "type": "string",
        "minLength": 1
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "description",
            "quantity",
            "unitPriceVnd"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "unitPriceVnd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          }
        }
      },
      "amountVnd": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000000
      },
      "insuranceStatus": {
        "type": "string"
      },
      "confirmed": {
        "type": "boolean",
        "enum": [
          true
        ]
      },
      "createdBy": {
        "type": "object",
        "required": [
          "subject",
          "displayName"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      }
    }
  },
  "indexed": [
    "requestId",
    "admissionId",
    "patientSubject",
    "claimId"
  ],
  "uniqueKey": "requestId",
  "searchable": [],
  "sensitive": [
    "patientSubject",
    "patientName",
    "birthYear",
    "sex",
    "items",
    "amountVnd",
    "claimId",
    "admissionId",
    "noteId",
    "createdBy"
  ]
}

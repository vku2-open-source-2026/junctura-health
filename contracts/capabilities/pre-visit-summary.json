{
  "slug": "pre-visit-summary",
  "version": "1.0.0",
  "provider": "junctura-clinic",
  "consumers": [
    "junctura-hospital"
  ],
  "purposes": [
    "treatment"
  ],
  "emergencyAccess": true,
  "title": "Tóm tắt trước khám",
  "description": "Dị ứng, bệnh mạn tính, thuốc đang dùng và tối đa 3 lần khám gần nhất của người bệnh tại trạm y tế, để bác sĩ tuyến trên khám không phải hỏi lại.",
  "inputSchema": {
    "type": "object",
    "description": "Không có tham số: người bệnh được xác định qua context.dataSubject.",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "patientName": {
        "type": "string",
        "maxLength": 120,
        "description": "Họ tên người bệnh."
      },
      "birthYear": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100,
        "description": "Năm sinh."
      },
      "sex": {
        "type": "string",
        "maxLength": 16,
        "description": "female | male | other"
      },
      "allergies": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "substance": {
              "type": "string",
              "maxLength": 120,
              "description": "Chất gây dị ứng, ví dụ Penicillin."
            },
            "severity": {
              "type": "string",
              "maxLength": 16,
              "description": "mild | moderate | severe"
            },
            "reaction": {
              "type": "string",
              "maxLength": 240,
              "description": "Biểu hiện đã ghi nhận."
            }
          },
          "required": [
            "substance",
            "severity",
            "reaction"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      },
      "chronicConditions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 16,
              "description": "Mã ICD-10."
            },
            "name": {
              "type": "string",
              "maxLength": 160
            },
            "since": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Ngày dạng YYYY-MM-DD."
            }
          },
          "required": [
            "code",
            "name",
            "since"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      },
      "currentMedications": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 160
            },
            "dose": {
              "type": "string",
              "maxLength": 80,
              "description": "Liều dùng, ví dụ 500 mg x 2 lần/ngày."
            },
            "since": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Ngày dạng YYYY-MM-DD."
            }
          },
          "required": [
            "name",
            "dose",
            "since"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      },
      "recentEncounters": {
        "type": "array",
        "description": "Tối đa 3 lần khám gần nhất, mới nhất trước.",
        "items": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "minLength": 10,
              "maxLength": 10,
              "description": "Ngày dạng YYYY-MM-DD."
            },
            "reason": {
              "type": "string",
              "maxLength": 240,
              "description": "Lý do khám."
            },
            "diagnosis": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 16,
                  "description": "Mã ICD-10."
                },
                "name": {
                  "type": "string",
                  "maxLength": 160,
                  "description": "Tên chẩn đoán."
                }
              },
              "required": [
                "code",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "date",
            "reason",
            "diagnosis"
          ],
          "additionalProperties": false
        },
        "maxItems": 3
      },
      "updatedAt": {
        "type": "string",
        "minLength": 20,
        "maxLength": 30,
        "description": "Thời điểm ISO 8601 (UTC)."
      }
    },
    "required": [
      "patientName",
      "birthYear",
      "sex",
      "allergies",
      "chronicConditions",
      "currentMedications",
      "recentEncounters",
      "updatedAt"
    ],
    "additionalProperties": false
  },
  "sideEffects": {
    "kind": "none",
    "description": "Chỉ đọc; không thay đổi dữ liệu của bên cung cấp.",
    "idempotency": "none"
  },
  "timeoutMs": 3000
}
